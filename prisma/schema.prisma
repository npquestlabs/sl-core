// ----------------------------------------
// Boilerplate
// ----------------------------------------

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ----------------------------------------
// Core Models
// ----------------------------------------

model User {
  id String @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid

  email     String  @unique @db.VarChar(255)
  password  String? @map("password_hash")
  avatarUrl String? @map("avatar_url")

  maintenanceRequests MaintenanceRequest[]
  notifications       Notification[]

  staff  Staff?
  tenant Tenant?
  vendor Vendor?

  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@index([email], map: "users_idx_email")
  @@map("users")
}

model Complex {
  id String @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid

  name        String  @db.VarChar(255)
  countryCode String  @map("country_code") @db.Char(3)
  cityName    String  @map("city_name")
  address     String?
  description String?
  notes       String?

  logoUrl String? @map("logo_url")

  bankName          String? @map("bank_name") @db.VarChar(100)
  bankAccount       String? @map("bank_account") @db.VarChar(100)
  mobileMoneyNumber String? @map("mobile_money_number") @db.VarChar(50)

  createdBy String @db.Uuid

  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  creator        Staff               @relation(fields: [createdBy], references: [id], onDelete: Cascade, onUpdate: NoAction)
  units          Unit[]
  assignments    ComplexAssignment[]
  leaseTemplates LeaseTemplate[]

  @@map("complexes")
}

model Unit {
  id String @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid

  complexId   String    @map("complex_id") @db.Uuid
  label       String    @db.VarChar(100)
  type        UnitType?
  description String?
  notes       String?

  rentAmount   Decimal?      @map("rent_amount") @db.Decimal(18, 2)
  rentCurrency String?       @default("GHS") @map("rent_currency") @db.VarChar(3)
  rentDuration RentDuration? @map("rent_duration")

  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  rules String?

  occupancies         Occupancy[]
  maintenanceRequests MaintenanceRequest[]
  complex             Complex              @relation(fields: [complexId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([complexId], map: "units_idx_complex_id")
  @@map("units")
}

// Used for prepopulating lease aggrements
model LeaseTemplate {
  id        String @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  complexId String @map("complex_id") @db.Uuid
  name      String @db.VarChar(255)

  // Landlord/Manager's details
  signedBy       String  @map("signed_by") @db.VarChar(255)
  signerRole     String  @map("signer_role") @db.VarChar(255)
  signature      Bytes?  @map("signature") // encrypted with PBKDF2
  signerIdType   IdType? @map("signer_id_type")
  signerIdNumber String? @map("signer_id_number")

  // Standard terms
  terms        String?
  noticePeriod Int?    @default(30) @map("notice_period")

  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  complex Complex @relation(fields: [complexId], references: [id], onDelete: Cascade)

  @@map("lease_templates")
}

model Lease {
  id String @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid

  serial          String @unique

  // --- Denormalized Fields for Read-Only History ---
  propertyName String @map("property_name") @db.VarChar(512) // `[complexName] [unitType] [unitLabel]`
  tenantName   String @map("tenant_name") @db.VarChar(512)

  // --- Lease Details (can override template) ---
  startsAt DateTime @map("starts_at") @db.Timestamptz(6)
  endsAt   DateTime @map("ends_at") @db.Timestamptz(6)

  rentAmount   Decimal       @map("rent_amount") @db.Decimal(18, 2) // unit price
  rentDuration RentDuration? @map("rent_duration")
  rentCurrency String        @default("GHS") @map("rent_currency") @db.VarChar(3)
  rentQuotas   Int?          @default(0) @map("rent_quotas") // number of unit durations aggreed on

  // Populated from template at app - level
  signedBy       String  @map("signed_by") @db.VarChar(255)
  signerRole     String  @map("signer_role") @db.VarChar(255)
  signature      Bytes?  @map("signature") // encrypted with PBKDF2
  signerIdType   IdType? @map("signer_id_type")
  signerIdNumber String? @map("signer_id_number")
  // Standard terms
  terms          String?
  noticePeriod   Int?    @default(30) @map("notice_period") // needed for lease termination

  // --- Timestamps & Relations ---
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  currentOccupancy  Occupancy? @relation("currentLease") // All leases without a null `currentOccupancy` are considered `Outdated`
  previousOccupancy Occupancy? @relation("previousLease")

  @@map("leases")
}

model Notification {
  id      String @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId  String @map("user_id") @db.Uuid
  brief   String @map("brief") @db.VarChar(255) // for titles and stuff
  message String @map("message") @db.VarChar(1024) // markdown format

  isRead Boolean @default(false) @map("is_read")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("notifications")
}

model Occupancy {
  id String @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid

  unitId   String @map("unit_id") @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  currentLeaseId String @unique @map("current_lease_id") @db.Uuid

  previousLeaseId    String?             @unique @map("previous_lease_id") @db.Uuid
  leaseExtensionType LeaseExtensionType? @map("lease_extension_type") // Will be non-null when previousLeaseId is non-null

  // --- Relations ---
  unit   Unit   @relation(fields: [unitId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  currentLease   Lease     @relation(name: "currentLease", fields: [currentLeaseId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  previousLease  Lease?    @relation(name: "previousLease", fields: [previousLeaseId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  tenantPayments Payment[]

  @@unique([unitId, tenantId])
  @@map("occupancies")
}

// ----------------------------------------
// User Role & Profile Models
// ----------------------------------------

model Staff {
  id String @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid

  firstName  String  @map("first_name") @db.VarChar(255)
  lastName   String  @map("last_name") @db.VarChar(255)
  middleName String? @map("middle_name") @db.VarChar(255)
  phone      String? @db.VarChar(50)

  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  userId String @unique @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id])

  assignments ComplexAssignment[]
  creations   Complex[]

  @@map("staff")
}

model Tenant {
  id String @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid

  firstName  String  @map("first_name") @db.VarChar(255)
  lastName   String  @map("last_name") @db.VarChar(255)
  middleName String? @map("middle_name") @db.VarChar(255)
  phone      String? @db.VarChar(50)
  email      String? @db.VarChar(50)

  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  userId String? @unique @map("user_id") @db.Uuid

  user        User?       @relation(fields: [userId], references: [id])
  occupancies Occupancy[]

  @@map("tenants")
}

model Vendor {
  id String @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid

  firstName  String  @map("first_name") @db.VarChar(255)
  lastName   String  @map("last_name") @db.VarChar(255)
  middleName String? @map("middle_name") @db.VarChar(255)
  phone      String? @db.VarChar(50)
  email      String? @db.VarChar(50)

  specialty String?   @db.VarChar(255)
  rating    Float?    @default(0.0)
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  bankName          String? @map("bank_name") @db.VarChar(100)
  bankAccount       String? @map("bank_account") @db.VarChar(100)
  mobileMoneyNumber String? @map("mobile_money_number") @db.VarChar(50)

  userId String? @unique @map("user_id") @db.Uuid

  user                User?                @relation(fields: [userId], references: [id])
  maintenanceRequests MaintenanceRequest[]
  payments            Payment[]

  @@map("vendors")
}

// But I aced it:
model ComplexAssignment {
  id        String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  staffId   String    @map("staff_id") @db.Uuid
  complexId String    @map("complex_id") @db.Uuid
  role      StaffRole @default(REGULAR)

  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)

  staff   Staff   @relation(fields: [staffId], references: [id])
  complex Complex @relation(fields: [complexId], references: [id])

  @@unique([staffId, complexId])
  @@map("complex_assignments")
}

// ----------------------------------------
// Transactional & Utility Models
// ----------------------------------------

model Payment {
  id String @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid

  amount         Decimal       @db.Decimal(18, 2)
  currency       String        @default("GHS") @db.VarChar(3)
  type           PaymentType
  dueDate        DateTime      @map("due_date") @db.Timestamptz(6)
  paidAt         DateTime?     @default(now()) @map("paid_at") @db.Timestamptz(6)
  method         PaymentMethod
  paymentStatus  PaymentStatus @default(PENDING) @map("payment_status")
  transactionRef String?       @unique @map("transaction_ref") @db.VarChar(255)
  feeAmount      Decimal?      @map("fee_amount") @db.Decimal(18, 2)
  receiptUrl     String?       @map("receipt_url") @db.VarChar(1023)
  createdAt      DateTime?     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime?     @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime?     @map("deleted_at") @db.Timestamptz(6)

  // Types of payments
  occupancyId String? @map("occupancy_id") @db.Uuid
  vendorId    String? @map("vendor_id") @db.Uuid

  // Relations
  occupancy Occupancy? @relation(fields: [occupancyId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  vendor    Vendor?    @relation(fields: [vendorId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([occupancyId], map: "payments_idx_occupancy_id")
  @@index([vendorId], map: "payments_idx_vendor_id")
  @@map("payments")
}

model MaintenanceRequest {
  id String @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid

  unitId         String            @map("unit_id") @db.Uuid
  creatorId      String            @map("creator_id") @db.Uuid
  description    String
  photoUrl       String?           @map("photo_url") @db.VarChar(1023)
  status         MaintenanceStatus @default(PENDING)
  vendorId       String?           @map("vendor_id") @db.Uuid
  vendorResponse String?           @map("vendor_response")
  scheduledFor   DateTime?         @map("scheduled_for") @db.Timestamptz(6)
  completedAt    DateTime?         @map("completed_at") @db.Timestamptz(6)
  cost           Decimal?          @db.Decimal(18, 2)
  costCurrency   String?           @default("GHS") @map("cost_currency") @db.VarChar(3)
  paymentStatus  InvoiceStatus?    @map("payment_status")
  createdAt      DateTime?         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime?         @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime?         @map("deleted_at") @db.Timestamptz(6)

  creator User    @relation(fields: [creatorId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  unit    Unit    @relation(fields: [unitId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  vendor  Vendor? @relation(fields: [vendorId], references: [id], onUpdate: NoAction)

  @@index([creatorId], map: "maintenance_requests_idx_creator_id")
  @@index([unitId], map: "maintenance_requests_idx_unit_id")
  @@index([vendorId], map: "maintenance_requests_idx_vendor_id")
  @@map("maintenance_requests")
}

model Otp {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  email     String   @db.VarChar(255)
  otp       String   @db.VarChar(10)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  expiresAt DateTime @db.Timestamptz(6)
  used      Boolean  @default(false)

  @@index([email], map: "otp_idx_email")
  @@map("otps")
}

// ----------------------------------------
// Enums
// ----------------------------------------

enum IdType {
  VOTER_ID
  PASSPORT
  DRIVER_LICENSE
  GH_CARD
}

enum InvoiceStatus {
  PENDING
  PAID
  OVERDUE
  CANCELED
}

enum StaffRole {
  SUPERADMIN
  ADMIN
  REGULAR
}

enum MaintenanceStatus {
  PENDING
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELED
}

enum PaymentMethod {
  MOBILE_MONEY
  BANK_TRANSFER
  CARD
  CASH
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum PaymentType {
  RENT
  UTILITY
  MAINTENANCE
  DEPOSIT
}

enum UnitType {
  ROOM
  STUDIO
  APARTMENT
  HOUSE
}

enum RentDuration {
  DAY
  WEEK
  MONTH
  YEAR
  SEMESTER
  ACADEMIC_YEAR
}

enum LeaseExtensionType {
  EDIT
  RENEWAL
}
